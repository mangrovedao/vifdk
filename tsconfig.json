{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "preserve",
		"moduleResolution": "bundler"
	},
	"include": ["./src/**/*.ts", "./test/**/*.ts"],
	"exclude": [
		"./src/_cjs/**",
		"./src/_esm/**",
		"./src/_types/**",
		"./src/**/*.test.ts",
		"./test/**"
	]
}
