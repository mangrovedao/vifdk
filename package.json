{
	"name": "vifdk",
	"description": "Typescript SDK to interact with the Vif order-book DeX",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/_cjs/index.js",
	"module": "./src/_esm/index.js",
	"types": "./src/_types/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/_types/index.d.ts",
			"import": "./src/_esm/index.js",
			"default": "./src/_cjs/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src/_cjs",
		"src/_esm",
		"src/_types"
	],
	"homepage": "https://github.com/mangrovedao/vifdk#readme",
	"bugs": {
		"url": "https://github.com/mangrovedao/vifdk/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mangrovedao/vifdk.git"
	},
	"scripts": {
		"build": "bun run clean && bun run build:cjs && bun run build:esm && bun run build:types",
		"build:cjs": "tsc --project tsconfig.cjs.json && printf '{\"type\":\"commonjs\"}' > ./src/_cjs/package.json",
		"build:esm": "tsc --project tsconfig.esm.json && printf '{\"type\":\"module\",\"sideEffects\":false}' > ./src/_esm/package.json",
		"build:types": "tsc --project tsconfig.types.json",
		"clean": "rm -rf ./src/_cjs ./src/_esm ./src/_types",
		"postinstall": "bun simple-git-hooks",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"type-check": "tsc --noEmit",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "bun run build && changeset publish"
	},
	"peerDependencies": {
		"typescript": ">=4.5.0",
		"viem": ">=2.38.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.0",
		"@types/bun": "^1.3.1",
		"prool": "^0.2.2",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3",
		"viem": ">=2.38.0",
		"vitest": "^2.0.0"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	}
}
