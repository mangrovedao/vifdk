{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./src/_cjs",
		"module": "commonjs",
		"moduleResolution": "node",
		"verbatimModuleSyntax": false,
		"sourceMap": true
	},
	"include": ["./src"],
	"exclude": ["./src/**/*.test.ts", "./src/**/*.test-d.ts"]
}
